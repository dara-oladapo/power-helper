<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!--
	  The sandbox is off deliberately. Reading battery state runs /usr/bin/pmset and the
	  start-at-login switch writes a LaunchAgent plist into ~/Library/LaunchAgents; a
	  sandboxed app can do neither. That rules out Mac App Store distribution, which this
	  app was never a candidate for - it is a free utility distributed directly.
	-->
	<key>com.apple.security.app-sandbox</key>
	<false/>
</dict>
</plist>
