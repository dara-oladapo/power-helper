<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!--
      One head per host OS, rather than every head everywhere. Building the macOS target
      needs the maui-maccatalyst workload and an Xcode toolchain, and the Windows target
      needs maui-windows; asking either CI job to restore the other's workload costs minutes
      per run for something it cannot build anyway.

      There is deliberately no Linux entry: .NET MAUI has no Linux target at all. That is
      tracked in issue #3, not papered over here.
    -->
    <TargetFrameworks Condition="$([MSBuild]::IsOSPlatform('windows'))">net10.0-windows10.0.19041.0</TargetFrameworks>
    <TargetFrameworks Condition="$([MSBuild]::IsOSPlatform('osx'))">net10.0-maccatalyst</TargetFrameworks>
    <!-- Anywhere else, name the Windows head so the failure says "install maui-windows"
         rather than "TargetFrameworks is empty". -->
    <TargetFrameworks Condition="'$(TargetFrameworks)' == ''">net10.0-windows10.0.19041.0</TargetFrameworks>
    <OutputType>Exe</OutputType>
    <RootNamespace>PowerHelper.App</RootNamespace>
    <AssemblyName>PowerHelper</AssemblyName>
    <UseMaui>true</UseMaui>
    <SingleProject>true</SingleProject>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <ApplicationTitle>Power Helper</ApplicationTitle>
    <ApplicationId>com.daraoladapo.powerhelper</ApplicationId>

    <!-- Baseline for local/dev builds - keep this matching the latest git tag. The release
         workflow overrides it with the exact tag version at publish time regardless, so this
         only drifts between releases, never for an actual published build. -->
    <ApplicationDisplayVersion>0.2.0</ApplicationDisplayVersion>
    <ApplicationVersion>1</ApplicationVersion>
    <Version>0.2.0</Version>

    <!--
      Unpackaged, and it has to be. The app enables and disables a PCI device, which needs
      administrator rights, and an MSIX-packaged app cannot request elevation at all - its
      requestedExecutionLevel is ignored and it always runs at medium integrity. Unpackaged
      WinUI 3 is the only shape of MAUI app that can hold the privileges this one needs.
    -->
    <WindowsPackageType Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">None</WindowsPackageType>

    <!--
      Required, not a preference. WindowsPackageType=None makes the app self-contained, so
      the build needs the .NET and WindowsDesktop runtime packs - and NuGet only downloads
      those when a RuntimeIdentifier is present at restore time. Without it, restore
      succeeds and the build then fails with NETSDK1112 asking for exactly this.

      WindowsDesktop is in that list because PowerHelper.Windows carries the WinForms tray
      icon and the reference flows through.

      Scoped to the Windows target framework. Left unconditional it leaked into the macOS
      head, which then tried to restore Microsoft.NETCore.App.Runtime.Mono.win-x64 and
      failed with NU1102.
    -->
    <RuntimeIdentifier Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">win-x64</RuntimeIdentifier>

    <!--
      Stated explicitly rather than left to be inferred. Unpackaged WinUI needs the Windows
      App SDK present at runtime, and shipping it in the output is how that is guaranteed on
      a machine that has never seen it. Leaving it implicit let restore and build disagree
      about whether runtime packs were needed, which surfaced as NETSDK1112 at build time
      after a restore that had looked like it succeeded.

      The cost is a heavy build output even locally; that is the honest shape of this app.

      Windows-only, for the same reason as the RuntimeIdentifier above: Mac Catalyst decides
      its own deployment shape and does not want either of these forced on it.
    -->
    <SelfContained Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">true</SelfContained>
    <WindowsAppSDKSelfContained Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">true</WindowsAppSDKSelfContained>

    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</SupportedOSPlatformVersion>
    <TargetPlatformMinVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</TargetPlatformMinVersion>
    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'maccatalyst'">15.0</SupportedOSPlatformVersion>

    <ApplicationManifest Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">Platforms\Windows\app.manifest</ApplicationManifest>

    <!--
      Replaces the entry point WinUI would generate with Platforms/Windows/Program.cs, which
      takes the single-instance mutex before any window exists. A tray app that can be
      started twice ends up with two icons fighting over the same device.
    -->
    <DefineConstants Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">$(DefineConstants);DISABLE_XAML_GENERATED_MAIN</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <!-- App icon: a graphite badge with an amber bolt, matching the tray icon's weight. -->
    <MauiIcon Include="Resources\AppIcon\appicon.svg" ForegroundFile="Resources\AppIcon\appiconfg.svg" Color="#1A1A18" />

    <MauiSplashScreen Include="Resources\Splash\splash.svg" Color="#1A1A18" BaseSize="128,128" />

    <!--
      No <MauiFont>. The window deliberately uses the platform's own UI face - Segoe UI
      Variable on Windows 11, Segoe UI on Windows 10 - because a settings surface that ships
      its own typeface announces itself as third-party on a screen where every neighbouring
      window uses the system font.
    -->
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Maui.Controls" Version="$(MauiVersion)" />
    <PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="10.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\PowerHelper.Core\PowerHelper.Core.csproj" />
  </ItemGroup>

  <!--
    The Windows implementations, referenced only for the Windows target framework. A macOS
    head takes its implementations from Platforms/MacCatalyst instead, the way pc-cleaner
    does - only Windows needs a project of its own, because only Windows needs WinForms for
    the notification-area icon.
  -->
  <ItemGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">
    <ProjectReference Include="..\PowerHelper.Windows\PowerHelper.Windows.csproj" />
  </ItemGroup>

</Project>
