<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!--
      The one binary in this solution that runs elevated (via a pre-registered RunLevel
      Highest scheduled task - see WindowsGpuController). Deliberately standalone: no
      ProjectReference to PowerHelper.Windows or PowerHelper.Core, so the privileged surface
      is this file alone, not this file plus everything MAUI/WinForms pulls in. The discrete
      GPU lookup below intentionally duplicates WindowsGpuController.FindDiscreteGpuInstanceId
      rather than sharing it, for the same reason.
    -->
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RootNamespace>PowerHelper.GpuHelper</RootNamespace>
    <AssemblyName>PowerHelper.GpuHelper</AssemblyName>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.Management" Version="8.0.0" />
  </ItemGroup>

</Project>
