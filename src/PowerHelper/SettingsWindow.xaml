<Window x:Class="PowerHelper.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Power Helper" Height="820" Width="460"
        MinHeight="420" MinWidth="320"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize"
        Background="#1A1A18"
        FontFamily="Segoe UI"
        Loaded="OnWindowLoaded">

    <Window.Resources>
        <SolidColorBrush x:Key="PanelBrush" Color="#232320"/>
        <SolidColorBrush x:Key="HairlineBrush" Color="#3A3A34"/>
        <SolidColorBrush x:Key="AmberBrush" Color="#FFB020"/>
        <SolidColorBrush x:Key="TextPrimaryBrush" Color="#EDEAE0"/>
        <SolidColorBrush x:Key="TextMutedBrush" Color="#8C897E"/>
        <FontFamily x:Key="MonoFont">Cascadia Mono, Consolas, Courier New</FontFamily>

        <Style x:Key="SectionHeaderStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="4,0,0,8"/>
        </Style>

        <Style x:Key="RowLabelStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="FontSize" Value="13.5"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="RowSubLabelStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,2,0,0"/>
        </Style>

        <Style x:Key="TelemetryStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="FontFamily" Value="{StaticResource MonoFont}"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>

        <Style x:Key="PanelStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource PanelBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource HairlineBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="3"/>
            <Setter Property="Padding" Value="16,14"/>
        </Style>

        <!-- One reflowing card: section label + panel, sized together so a card's label
             never separates from its own panel when the grid rewraps into more columns. -->
        <Style x:Key="CardWrapperStyle" TargetType="StackPanel">
            <Setter Property="Margin" Value="0,0,14,14"/>
        </Style>

        <!-- Rocker switch: a lit LED dot on the active side, not a sliding pill -
             deliberately reads as physical equipment hardware, not a phone UI metaphor. -->
        <Style x:Key="ToggleSwitchStyle" TargetType="CheckBox">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Width" Value="46"/>
            <Setter Property="Height" Value="24"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Border x:Name="Track" Width="46" Height="24" CornerRadius="2"
                                Background="#141412" BorderBrush="{StaticResource HairlineBrush}" BorderThickness="1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Rectangle Grid.ColumnSpan="2" Width="1" Fill="#0D0D0B" HorizontalAlignment="Center"/>
                                <Ellipse x:Name="OffDot" Grid.Column="0" Width="6" Height="6" Fill="#8C897E"/>
                                <Ellipse x:Name="OnDot" Grid.Column="1" Width="6" Height="6" Fill="#4A473F"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="OnDot" Property="Fill" Value="{StaticResource AmberBrush}"/>
                                <Setter TargetName="OffDot" Property="Fill" Value="#4A473F"/>
                                <Setter TargetName="OnDot" Property="Effect">
                                    <Setter.Value>
                                        <DropShadowEffect Color="#FFB020" BlurRadius="8" ShadowDepth="0" Opacity="0.85"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.35"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ActionButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#141412"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource HairlineBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontFamily" Value="{StaticResource MonoFont}"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="2" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#1E1E1B"/>
                    <Setter Property="BorderBrush" Value="{StaticResource AmberBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="Slider">
            <Setter Property="Foreground" Value="{StaticResource AmberBrush}"/>
        </Style>
    </Window.Resources>

    <!-- ScrollViewer is a safety net, not the primary layout mechanism: the WrapPanel below
         reflows into more columns as the window widens, so scrolling is only ever needed if
         the window is made narrower and shorter than the content can reasonably compress to. -->
    <ScrollViewer x:Name="RootScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="18">
        <!-- Capped and centered rather than letting cards stretch edge-to-edge on very wide
             windows - past this width, extra room becomes margin, not dead space inside cards. -->
        <StackPanel MaxWidth="1400" HorizontalAlignment="Center">

            <!-- Header / nameplate - stays full width regardless of column count -->
            <Border Style="{StaticResource PanelStyle}" Margin="0,0,0,18">
                <StackPanel>
                    <TextBlock Text="P O W E R   H E L P E R" Foreground="{StaticResource TextPrimaryBrush}"
                               FontSize="17" FontWeight="SemiBold"/>
                    <Rectangle Height="1" Fill="{StaticResource HairlineBrush}" Margin="0,10,0,10"/>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                        <Ellipse x:Name="BatteryLed" Width="7" Height="7" Fill="#4A473F" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock x:Name="BatteryStatusText" Text="BATTERY: CHECKING..." Style="{StaticResource TelemetryStyle}"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Ellipse x:Name="GpuLed" Width="7" Height="7" Fill="#4A473F" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock x:Name="GpuStatusText" Text="DGPU: CHECKING..." Style="{StaticResource TelemetryStyle}"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Reflowing card grid: 1 column on a narrow sidebar, more columns as the window
                 widens. Code-behind (UpdateCardLayout) regroups these into centered rows on
                 every size change, rather than a plain WrapPanel wrap, specifically so an
                 incomplete last row centers instead of trailing off with a gap. -->
            <StackPanel x:Name="CardsPanel" SizeChanged="OnCardsPanelSizeChanged">

                <!-- GPU -->
                <StackPanel Style="{StaticResource CardWrapperStyle}">
                    <TextBlock Text="DISCRETE GPU" Style="{StaticResource SectionHeaderStyle}"/>
                    <Border Style="{StaticResource PanelStyle}">
                        <StackPanel>
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Disable dGPU on battery" Style="{StaticResource RowLabelStyle}"/>
                                    <TextBlock Text="Forces the discrete GPU off (via Device Manager) whenever unplugged, regardless of which app is running."
                                               Style="{StaticResource RowSubLabelStyle}"/>
                                </StackPanel>
                                <CheckBox x:Name="AutoDisableGpuToggle" Grid.Column="1" Style="{StaticResource ToggleSwitchStyle}"
                                          Checked="OnAutoDisableGpuChanged" Unchecked="OnAutoDisableGpuChanged"/>
                            </Grid>
                            <Button x:Name="ManualGpuButton" Content="ENABLE DGPU NOW" Style="{StaticResource ActionButtonStyle}"
                                    HorizontalAlignment="Left" Click="OnManualGpuButtonClick"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Power plan -->
                <StackPanel Style="{StaticResource CardWrapperStyle}">
                    <TextBlock Text="POWER PLAN" Style="{StaticResource SectionHeaderStyle}"/>
                    <Border Style="{StaticResource PanelStyle}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Match Windows power plan to power source" Style="{StaticResource RowLabelStyle}"/>
                                <TextBlock Text="Power saver on battery, Balanced on AC. Performance stays a manual choice (Fn+Q) so it never forces the fan up for no thermal reason."
                                           Style="{StaticResource RowSubLabelStyle}"/>
                            </StackPanel>
                            <CheckBox x:Name="PowerPlanToggle" Grid.Column="1" Style="{StaticResource ToggleSwitchStyle}"
                                      Checked="OnPowerPlanChanged" Unchecked="OnPowerPlanChanged"/>
                        </Grid>
                    </Border>
                </StackPanel>

                <!-- Refresh rate -->
                <StackPanel Style="{StaticResource CardWrapperStyle}">
                    <TextBlock Text="DISPLAY" Style="{StaticResource SectionHeaderStyle}"/>
                    <Border Style="{StaticResource PanelStyle}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock x:Name="RefreshRateLabel" Text="Drop refresh rate on battery" Style="{StaticResource RowLabelStyle}"/>
                                <TextBlock x:Name="RefreshRateSubLabel" Text="Restores your native refresh rate on AC or when the app exits."
                                           Style="{StaticResource RowSubLabelStyle}"/>
                            </StackPanel>
                            <CheckBox x:Name="RefreshRateToggle" Grid.Column="1" Style="{StaticResource ToggleSwitchStyle}"
                                      Checked="OnRefreshRateChanged" Unchecked="OnRefreshRateChanged"/>
                        </Grid>
                    </Border>
                </StackPanel>

                <!-- Brightness -->
                <StackPanel Style="{StaticResource CardWrapperStyle}">
                    <TextBlock Text="BRIGHTNESS" Style="{StaticResource SectionHeaderStyle}"/>
                    <Border Style="{StaticResource PanelStyle}">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock x:Name="BrightnessLabel" Text="Lock brightness on battery" Style="{StaticResource RowLabelStyle}"/>
                                    <TextBlock x:Name="BrightnessSubLabel" Text="Caps the panel at the level below whenever unplugged. Restores exactly what you had set on AC or when the app exits."
                                               Style="{StaticResource RowSubLabelStyle}"/>
                                </StackPanel>
                                <CheckBox x:Name="BrightnessToggle" Grid.Column="1" Style="{StaticResource ToggleSwitchStyle}"
                                          Checked="OnBrightnessEnabledChanged" Unchecked="OnBrightnessEnabledChanged"/>
                            </Grid>
                            <Grid Margin="0,14,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="50"/>
                                </Grid.ColumnDefinitions>
                                <Slider x:Name="BrightnessSlider" Grid.Column="0" Minimum="10" Maximum="100"
                                        TickFrequency="10" IsSnapToTickEnabled="True"
                                        VerticalAlignment="Center"
                                        ValueChanged="OnBrightnessLevelChanged"
                                        PreviewMouseWheel="OnSliderPreviewMouseWheel"/>
                                <TextBlock x:Name="BrightnessValueText" Grid.Column="1" Text="50%"
                                           Style="{StaticResource TelemetryStyle}"
                                           HorizontalAlignment="Right" VerticalAlignment="Center"/>
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Low battery warning -->
                <StackPanel Style="{StaticResource CardWrapperStyle}">
                    <TextBlock Text="BATTERY WARNING" Style="{StaticResource SectionHeaderStyle}"/>
                    <Border Style="{StaticResource PanelStyle}">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Warn me when battery is low" Style="{StaticResource RowLabelStyle}" Grid.Column="0"/>
                                <CheckBox x:Name="LowBatteryToggle" Grid.Column="1" Style="{StaticResource ToggleSwitchStyle}"
                                          Checked="OnLowBatteryEnabledChanged" Unchecked="OnLowBatteryEnabledChanged"/>
                            </Grid>
                            <Grid Margin="0,14,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="50"/>
                                </Grid.ColumnDefinitions>
                                <Slider x:Name="ThresholdSlider" Grid.Column="0" Minimum="5" Maximum="50"
                                        TickFrequency="5" IsSnapToTickEnabled="True"
                                        VerticalAlignment="Center"
                                        ValueChanged="OnThresholdChanged"
                                        PreviewMouseWheel="OnSliderPreviewMouseWheel"/>
                                <TextBlock x:Name="ThresholdValueText" Grid.Column="1" Text="15%"
                                           Style="{StaticResource TelemetryStyle}"
                                           HorizontalAlignment="Right" VerticalAlignment="Center"/>
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Startup -->
                <StackPanel Style="{StaticResource CardWrapperStyle}">
                    <TextBlock Text="STARTUP" Style="{StaticResource SectionHeaderStyle}"/>
                    <Border Style="{StaticResource PanelStyle}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Start with Windows" Style="{StaticResource RowLabelStyle}"/>
                                <TextBlock Text="Registers an elevated logon task so these settings actually hold across reboots, without repeated UAC prompts."
                                           Style="{StaticResource RowSubLabelStyle}"/>
                            </StackPanel>
                            <CheckBox x:Name="StartupToggle" Grid.Column="1" Style="{StaticResource ToggleSwitchStyle}"
                                      Checked="OnStartupChanged" Unchecked="OnStartupChanged"/>
                        </Grid>
                    </Border>
                </StackPanel>

            </StackPanel>

            <!-- Footer -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,4,0,0">
                <TextBlock x:Name="VersionText" Text="v0.0.0" Style="{StaticResource RowSubLabelStyle}"/>
                <TextBlock Text="  •  " Style="{StaticResource RowSubLabelStyle}"/>
                <TextBlock Text="View on GitHub" Foreground="{StaticResource TextMutedBrush}" FontSize="11.5"
                           Cursor="Hand" MouseLeftButtonUp="OnGitHubLinkClick" TextDecorations="Underline"/>
                <TextBlock x:Name="UpdateAvailableSeparator" Text="  •  " Style="{StaticResource RowSubLabelStyle}" Visibility="Collapsed"/>
                <TextBlock x:Name="UpdateAvailableLink" Text="Update available" Foreground="{StaticResource AmberBrush}" FontSize="11.5"
                           Cursor="Hand" MouseLeftButtonUp="OnUpdateLinkClick" TextDecorations="Underline" Visibility="Collapsed"/>
            </StackPanel>

        </StackPanel>
    </ScrollViewer>
</Window>
